# Servidor y Entorno
PORT=3000
NODE_ENV=production
CLIENT_URL="https://d1234567890.cloudfront.net"

# Seguridad y Autenticacion
JWT_SECRET="tu_jwt_secret_super_seguro_aqui"
HASHIDS_SALT="tu_hashids_salt_secreto_aqui"
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"

# Base de Datos (Neon / Vercel Postgres con Connection Pooling PgBouncer)
# NOTA: Para Vercel Serverless / Lambdas con Neon, usa el host con "-pooler", sslmode=require y connection_limit=1
DATABASE_URL="postgresql://usuario:password@ep-cool-fog-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&connection_limit=1&pgbouncer=true"

# AWS S3 (Bucket privado para comprobantes y público para productos/tienda)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="tu_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="tu_aws_secret_access_key"
AWS_BUCKET_NAME="tienda-donapaty-uploads"

# Open Food Facts (Opcional)
OPEN_FOOD_FACTS_USER_AGENT="TiendaInventario/1.0.0 (contacto: admin@tienda.com)"
